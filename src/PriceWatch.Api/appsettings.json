{
  "ConnectionStrings": {
    "PriceWatch": "Server=localhost;Port=3306;Database=pricewatch;Uid=root;Pwd=root;"
  },
  "PriceSync": {
    "IntervalMinutes": 30,
    "Latitude": 48.8566,
    "Longitude": 2.3522,
    "RadiusKm": 5
  },
  "FuelPriceApi": {
    "BaseUrl": "https://api.prix-carburants.2aaz.fr"
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName" ]
  },
  "AllowedHosts": "*"
}
